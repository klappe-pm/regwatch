{
  "name": "Bev Watch",
  "description": "The implemented blue and neutral visual system for Bev Watch.",
  "colors": {
    "bw-navy": "#183e56",
    "bw-ink": "#1b303c",
    "bw-muted": "#526674",
    "bw-line": "#d8e1e6",
    "bw-paper": "#f7f9fa",
    "raised": "#ffffff",
    "brand-red": "#b33a36",
    "focus": "#1d5a92",
    "button-hover": "#285c79",
    "light-hover": "#e9f1f5",
    "outline-hover": "#eaf0f4",
    "control-border": "#8b9da9",
    "tag-surface": "#e7f0f5",
    "tag-ink": "#24536d",
    "priority-surface": "#f8ebe5",
    "priority-ink": "#8d4026",
    "choice-border": "#a9bac4",
    "choice-selected-border": "#376d8a",
    "choice-selected-surface": "#edf4f8",
    "error-surface": "#fff0e9",
    "error-ink": "#933e25",
    "notice-surface": "#e8f3ed",
    "notice-ink": "#285d46",
    "selection-surface": "#dcebf3",
    "scrollbar": "#9babb5",
    "editorial-ink": "#2a617b",
    "outline-border": "#7a8e9c",
    "text-action": "#1d5a79",
    "feature-shadow": "#17395119",
    "preview-label": "#d6e6ee",
    "live-dot": "#bad7e6",
    "source-strip": "#f0f4f6",
    "step-number": "#607481",
    "closing-emphasis": "#c6dce8",
    "closing-copy": "#d8e6ee",
    "plan-icon": "#2b647c",
    "plan-surface": "#ecf2f6",
    "placeholder": "#5d6f7b",
    "note-surface": "#edf3f7",
    "note-ink": "#31536a",
    "nav-hover": "#f2f6f8",
    "banner-border": "#d5e2ea",
    "banner-surface": "#eef4f7",
    "banner-ink": "#34566c",
    "review-hover": "#286d91",
    "context-surface": "#edf2f5",
    "tab-selected": "#dfebf2",
    "review-copy": "#435c6c",
    "empty-icon": "#698391",
    "monogram-surface": "#e5edf2",
    "monogram-ink": "#335a71"
  },
  "typography": {
    "display": {
      "fontFamily": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif",
      "fontSize": "clamp(40px, 5.3vw, 74px)",
      "fontWeight": 550,
      "lineHeight": 1.1,
      "letterSpacing": "-.035em"
    },
    "headline": {
      "fontSize": "48px",
      "fontWeight": 550,
      "lineHeight": 1.1,
      "letterSpacing": "-.035em"
    },
    "title": {
      "fontSize": "30px",
      "fontWeight": 550,
      "lineHeight": 1.25,
      "letterSpacing": "-.03em"
    },
    "body": {
      "fontSize": "15px",
      "lineHeight": 1.65
    },
    "label": {
      "fontSize": "13px",
      "fontWeight": 600
    },
    "editorial": {
      "fontFamily": "Georgia, serif",
      "fontWeight": 400
    }
  },
  "rounded": {
    "tag": "4px",
    "field": "5px",
    "control": "6px",
    "context": "8px",
    "form": "10px",
    "feature": "14px"
  },
  "spacing": {
    "compact": "8px",
    "field-gap": "10px",
    "control-gap": "12px",
    "action-gap": "22px",
    "panel": "24px",
    "section": "32px",
    "onboarding-panel": "38px"
  },
  "components": {
    "button-primary": {
      "backgroundColor": "{colors.bw-navy}",
      "textColor": "{colors.raised}",
      "rounded": "{rounded.control}",
      "padding": "12px 22px"
    },
    "button-primary-hover": {
      "backgroundColor": "{colors.button-hover}"
    },
    "button-small": {
      "padding": "10px 18px"
    },
    "button-light": {
      "backgroundColor": "{colors.raised}",
      "textColor": "{colors.bw-navy}",
      "rounded": "{rounded.control}",
      "padding": "12px 22px"
    },
    "button-outline": {
      "textColor": "{colors.bw-navy}",
      "rounded": "{rounded.control}",
      "padding": "12px 22px"
    },
    "field": {
      "backgroundColor": "{colors.raised}",
      "textColor": "{colors.bw-ink}",
      "rounded": "{rounded.field}",
      "padding": "10px 12px"
    },
    "tag": {
      "backgroundColor": "{colors.tag-surface}",
      "textColor": "{colors.tag-ink}",
      "rounded": "{rounded.tag}",
      "padding": "3px 8px"
    },
    "tag-priority": {
      "backgroundColor": "{colors.priority-surface}",
      "textColor": "{colors.priority-ink}"
    },
    "choice-selected": {
      "backgroundColor": "{colors.choice-selected-surface}",
      "rounded": "{rounded.control}",
      "padding": "13px"
    },
    "onboarding-panel": {
      "backgroundColor": "{colors.raised}",
      "rounded": "{rounded.feature}",
      "padding": "{spacing.onboarding-panel}"
    }
  }
}
