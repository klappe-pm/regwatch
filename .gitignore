# python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# virtual environments
.venv/
venv/
env/

# build outputs
build/
dist/
site/
*.whl

# web app: dependencies and Next.js working folders; the export ships in regwatch/web/
/web/node_modules/
/web/.next/
/web/out/
/web/site/
/web/dist/
/web/.vercel/
/local/
/.impeccable/review/
/web/next-env.d.ts
/web/src/lib/icons.generated.ts
/web/tsconfig.tsbuildinfo
# a user-level rule that ignores folders starting with an underscore must not hide the hashed chunks
!/regwatch/web/_next/

# secrets
.env
.env.*
!.env.example
settings.local.json

# os
.DS_Store

# internal work product: prompts, questions, provenance, session notes and
# any snapshot a hook writes; never published
.docs/

# editor state
.obsidian/
.obsidian-stage-*/

# regwatch run state and rendered output from the examples
/examples/state/
/examples/out/

# agent instruction files and runtime directories at the repository root:
# generated per machine, never tracked here
/AGENTS.md
/CLAUDE.md
/CODEX.md
/GEMINI.md
/OPENCODE.md
/.claude/
/.codex/
/.gemini/
/.cursor/
/.opencode/
/.agents/

# internal pages kept out of the public tree
/docs/documentation-guide/

# attribution check delivered by the local agent tooling: never tracked here
/.github/attribution-check/
/.github/workflows/attribution-check.yml
/.github/workflows/attribution-check-comment.yml
