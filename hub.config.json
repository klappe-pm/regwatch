{
  "hub": "http://127.0.0.1:4400",
  "project": "regwatch",
  "cmsDir": "docs/content-management-system",
  "sourceGeneration": {
    "commands": [
      ["npm", "--prefix", "web", "ci", "--offline", "--ignore-scripts"],
      ["npm", "--prefix", "web", "run", "sync"],
      ["npm", "--prefix", "web", "run", "build"]
    ],
    "outputs": [
      "web/design/copy.json",
      "web/design/ds.css",
      "web/design/spec.json",
      "web/design/tailwind.css",
      "web/src/lib/icons.generated.ts",
      "web/next-env.d.ts",
      "web/tsconfig.tsbuildinfo"
    ],
    "outputRoots": ["regwatch/web"],
    "handlesTokens": true,
    "timeoutMs": 120000
  }
}
